node_modules/
dist/

# What the seed and you put on the bundles server. The directory itself stays, so it's yours
# rather than created by Docker.
bundles/*
!bundles/.gitkeep

# The CLI's config and credentials for this demo (env.sh).
.appshell/

# Your own identity provider's settings, which Compose reads, and its CA (README).
.env
compose.override.yaml
ca.pem
